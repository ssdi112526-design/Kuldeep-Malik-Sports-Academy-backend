generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
  student
  coach
  parent
}

enum ContactStatus {
  new
  in_progress
  resolved
  closed
}

enum CoverageStatus {
  Active
  Growing
}

model User {
  id           String    @id @default(uuid())
  name         String    @db.VarChar(100)
  username     String?   @unique @db.VarChar(80)
  email        String    @unique @db.VarChar(255)
  mobile       String?   @db.VarChar(20)
  profileImage String?   @map("profile_image") @db.VarChar(500)
  password     String
  /** Separate from login password — unlocks mobile/admin Controller menu */
  controllerPassword           String?   @map("controller_password")
  controllerPasswordResetToken String?   @map("controller_password_reset_token") @db.VarChar(128)
  controllerPasswordResetExpires DateTime? @map("controller_password_reset_expires")
  role         UserRole  @default(user)
  roleId       String?   @map("role_id")
  studentId    String?   @unique @map("student_id")
  coachId      String?   @unique @map("coach_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  passwordResetToken   String?   @map("password_reset_token") @db.VarChar(128)
  passwordResetExpires DateTime? @map("password_reset_expires")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  roleRef                   Role?               @relation(fields: [roleId], references: [id], onDelete: SetNull)
  student                   Student?            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  coach                     Coach?              @relation(fields: [coachId], references: [id], onDelete: Cascade)
  parentProfile             ParentProfile?
  auditLogs                 AuditLog[]
  attendanceSessionsCreated      AttendanceSession[]
  coachAttendanceSessionsCreated CoachAttendanceSession[]

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(80)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system_role")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id         String @id @default(uuid())
  menu       String @db.VarChar(80)
  action     String @db.VarChar(40)
  key        String @unique @db.VarChar(120)
  label      String @db.VarChar(120)

  roles RolePermission[]

  @@unique([menu, action])
  @@map("permissions")
}

model RolePermission {
  id           String  @id @default(uuid())
  roleId       String  @map("role_id")
  permissionId String  @map("permission_id")
  allowed      Boolean @default(true)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String   @db.VarChar(80)
  entity    String?  @db.VarChar(80)
  entityId  String?  @map("entity_id") @db.VarChar(80)
  details   String?  @db.Text
  ip        String?  @db.VarChar(80)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Contact {
  id              String        @id @default(uuid())
  fullName        String        @map("full_name") @db.VarChar(120)
  email           String        @db.VarChar(255)
  phone           String?       @db.VarChar(20)
  panNumber       String?       @map("pan_number") @db.VarChar(10)
  aadhaarNumber   String?       @map("aadhaar_number") @db.VarChar(12)
  organisation    String?       @db.VarChar(150)
  serviceRequired String        @map("service_required")
  message         String        @db.VarChar(2000)
  status          ContactStatus @default(new)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([email, createdAt])
  @@index([status])
  @@index([createdAt])
  @@map("contacts")
}

model Service {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String   @default("FaCar")
  slug        String   @unique
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([order, isActive])
  @@map("services")
}

model Product {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String   @default("FaCar")
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("products")
}

model Partner {
  id        String   @id @default(uuid())
  name      String
  type      String
  status    String   @default("Active Partner")
  badge     String   @default("")
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([order, type])
  @@map("partners")
}

model TeamMember {
  id          String   @id @default(uuid())
  role        String
  experience  String
  description String
  icon        String   @default("FaUserTie")
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("team_members")
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([order])
  @@map("faqs")
}

model Equipment {
  id String @id @default(uuid())

  // Auto-generated (admin)
  equipmentCode String? @unique @db.VarChar(50) @map("equipment_code")

  // Public section (keep existing fields for the website)
  title       String
  description String
  icon        String   @default("FaTools")
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")

  // Entry management fields
  image String? @db.VarChar(400)

  category String? @db.VarChar(120)

  quantity Int @default(0)
  availableQuantity Int @default(0) @map("available_quantity")

  purchaseDate DateTime? @map("purchase_date")
  /// Money / invoice-style amounts (was Int — overflowed INT4 for values > 2^31-1)
  purchaseCost Decimal? @default(0) @map("purchase_cost") @db.Decimal(14, 2)
  supplier String? @db.VarChar(200)

  condition EquipmentCondition @default(Good)
  location String? @db.VarChar(120)
  rackNumber String? @map("rack_number") @db.VarChar(50)

  status EquipmentStatus @default(Available)
  maintenance String? @db.VarChar(2000)
  remarks String? @db.VarChar(2000)

  // QR + Barcode (barcode rendering can be added later)
  qrCodePath String? @map("qr_code_path") @db.VarChar(400)
  barcodeValue String? @map("barcode_value") @db.VarChar(120)

  history EquipmentHistory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([status])
  @@map("equipment")
}

model EquipmentHistory {
  id String @id @default(uuid())
  equipmentId String @map("equipment_id")
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  eventType String @map("event_type") // e.g. "status_change", "maintenance", "condition_change"
  description String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([equipmentId, createdAt])
  @@map("equipment_history")
}

model CoverageArea {
  id        String         @id @default(uuid())
  state     String
  city      String
  status    CoverageStatus @default(Active)
  isHQ      Boolean        @default(false) @map("is_hq")
  order     Int            @default(0)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([order, state])
  @@map("coverage_areas")
}

model Program {
  id           String   @id @default(uuid())
  title        String   @db.VarChar(200)
  description  String   @db.VarChar(2000)
  image        String?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([displayOrder, isActive])
  @@map("programs")
}

model GalleryItem {
  id                String   @id @default(uuid())
  title             String?  @db.VarChar(200)
  category          String   @default("General") @db.VarChar(100)
  image             String
  /** none | gold | silver | bronze | champion | national | state | winner */
  achievementType   String   @default("none") @map("achievement_type") @db.VarChar(40)
  achievementLabel  String?  @map("achievement_label") @db.VarChar(80)
  displayOrder      Int      @default(0) @map("display_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([displayOrder])
  @@index([category])
  @@map("gallery_items")
}

model Facility {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(200)
  description  String   @db.VarChar(2000)
  icon         String?  @db.VarChar(100)
  image        String?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([displayOrder, isActive])
  @@map("facilities")
}

/// Public “Meet Our Wrestlers” showcase athletes (admin-managed)
model Athlete {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(150)
  /// Weight / class label shown on cards (e.g. 76 KG)
  category       String   @db.VarChar(120)
  ageGroup       String?  @map("age_group") @db.VarChar(80)
  achievement    String?  @db.VarChar(200)
  description    String?  @db.VarChar(2000)
  image          String?  @db.VarChar(500)
  objectPosition String?  @map("object_position") @db.VarChar(80)
  displayOrder   Int      @default(0) @map("display_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([displayOrder, isActive])
  @@map("athletes")
}

/// Public Legacy / Prestigious Members (admin-managed CMS)
model LegacyMember {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(150)
  designation    String   @db.VarChar(120)
  achievement    String?  @db.VarChar(200)
  description    String   @db.VarChar(2000)
  image          String   @db.VarChar(500)
  objectPosition String?  @map("object_position") @db.VarChar(80)
  displayOrder   Int      @default(0) @map("display_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([displayOrder, isActive])
  @@index([name])
  @@map("legacy_members")
}

model Feature {
  id             String   @id @default(uuid())
  titleEn        String   @map("title_en") @db.VarChar(200)
  titleHi        String   @map("title_hi") @db.VarChar(200)
  descriptionEn  String   @map("description_en") @db.VarChar(1000)
  descriptionHi  String   @map("description_hi") @db.VarChar(1000)
  icon           String?  @db.VarChar(100)
  image          String?
  displayOrder   Int      @default(0) @map("display_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([displayOrder, isActive])
  @@map("features")
}

model MembershipPlan {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(200)
  description  String   @db.VarChar(2000)
  priceLabel   String?  @map("price_label") @db.VarChar(120)
  benefits     String?  @db.VarChar(3000)
  image        String?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([displayOrder, isActive])
  @@map("membership_plans")
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique @db.VarChar(80)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model Achievement {
  id           String   @id @default(uuid())
  labelEn      String   @map("label_en") @db.VarChar(120)
  labelHi      String   @map("label_hi") @db.VarChar(120)
  value        Int      @default(0)
  suffix       String   @default("+") @db.VarChar(10)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([displayOrder, isActive])
  @@map("achievements")
}

model ScheduleSession {
  id           String   @id @default(uuid())
  key          String   @unique @db.VarChar(40)
  titleEn      String   @map("title_en") @db.VarChar(120)
  titleHi      String   @map("title_hi") @db.VarChar(120)
  timeEn       String   @map("time_en") @db.VarChar(120)
  timeHi       String   @map("time_hi") @db.VarChar(120)
  noteEn       String?  @map("note_en") @db.VarChar(300)
  noteHi       String?  @map("note_hi") @db.VarChar(300)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([displayOrder, isActive])
  @@map("schedule_sessions")
}

model ScheduleDay {
  id           String   @id @default(uuid())
  dayKey       String   @unique @map("day_key") @db.VarChar(20)
  labelEn      String   @map("label_en") @db.VarChar(40)
  labelHi      String   @map("label_hi") @db.VarChar(40)
  morningEn    String   @map("morning_en") @db.VarChar(500)
  morningHi    String   @map("morning_hi") @db.VarChar(500)
  eveningEn    String   @map("evening_en") @db.VarChar(500)
  eveningHi    String   @map("evening_hi") @db.VarChar(500)
  isHoliday    Boolean  @default(false) @map("is_holiday")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([displayOrder, isActive])
  @@map("schedule_days")
}

enum VideoStatus {
  published
  draft
}

model Video {
  id           String      @id @default(uuid())
  title        String      @db.VarChar(200)
  slug         String      @unique @db.VarChar(220)
  subtitle     String?     @db.VarChar(300)
  description  String      @db.VarChar(3000)
  category     String      @db.VarChar(100)
  coachName    String?     @map("coach_name") @db.VarChar(120)
  duration     String?     @db.VarChar(20)
  thumbnail    String?
  videoFile    String?     @map("video_file")
  youtubeUrl   String?     @map("youtube_url") @db.VarChar(500)
  vimeoUrl     String?     @map("vimeo_url") @db.VarChar(500)
  isFeatured   Boolean     @default(false) @map("is_featured")
  displayOrder Int         @default(0) @map("display_order")
  status       VideoStatus @default(draft)
  views        Int         @default(0)
  fileSize     Int         @default(0) @map("file_size")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([displayOrder, status])
  @@index([category])
  @@index([isFeatured, status])
  @@map("videos")
}

// ---------------------------
// Entry Management
// ---------------------------

enum StudentStatus {
  Active
  Inactive
  Suspended
}

enum StudentGender {
  Male
  Female
  Other
}

enum TrainingLevel {
  Beginner
  Intermediate
  Advanced
  Professional
}

enum CoachStatus {
  Active
  Inactive
  Suspended
}

enum EquipmentCondition {
  Excellent
  Good
  Average
  Damaged
}

enum EquipmentStatus {
  Available
  InUse
  Maintenance
  Lost
}

enum PaymentStatus {
  Paid
  Pending
  Overdue
}

model Student {
  id String @id @default(uuid())

  // Auto-generated: AKH-2026-0001
  registrationNumber String @unique @db.VarChar(50) @map("registration_number")
  admissionNumber String? @db.VarChar(50) @map("admission_number")

  fullName String @db.VarChar(150) @map("full_name")
  fatherName String @db.VarChar(150) @map("father_name")
  motherName String @db.VarChar(150) @map("mother_name")
  gender StudentGender
  dateOfBirth DateTime @map("date_of_birth")

  bloodGroup String? @db.VarChar(10) @map("blood_group")
  mobileNumber String @db.VarChar(20) @map("mobile_number")
  alternateMobile String? @db.VarChar(20) @map("alternate_mobile")
  email String? @db.VarChar(255)

  // Address
  address String? @db.VarChar(220)
  village String? @db.VarChar(100)
  city String? @db.VarChar(100)
  district String? @db.VarChar(100)
  state String? @db.VarChar(100)
  pincode String? @db.VarChar(10)

  // Identity numbers (images live in StudentDocument)
  aadhaarNumber String @unique @db.VarChar(12) @map("aadhaar_number")
  panNumber String @unique @db.VarChar(10) @map("pan_number")

  // Student photo
  photo String? @db.VarChar(400)
  // Parent / guardian photo (on player record)
  parentPhoto String? @map("parent_photo") @db.VarChar(400)

  // Training
  joiningDate DateTime @map("joining_date")
  membershipType String @db.VarChar(120) @map("membership_type")
  batch String @db.VarChar(120)
  coachId String? @map("coach_id")
  coach Coach? @relation(fields: [coachId], references: [id])

  trainingLevel TrainingLevel @map("training_level")

  // Physical
  heightCm Int? @default(0) @map("height_cm")
  weightKg Int? @default(0) @map("weight_kg")
  chest Int? @default(0) @map("chest")
  age Int? @default(0)
  category String? // as provided (player category e.g. Khelo India)
  /// Optional wrestling age group label (e.g. U15, U17, Senior)
  ageCategory String? @map("age_category") @db.VarChar(80)
  /// Optional wrestling weight class label (e.g. 57 KG)
  weightCategory String? @map("weight_category") @db.VarChar(80)

  // Emergency
  guardianName String? @map("guardian_name")
  guardianRelation String? @map("guardian_relation")
  guardianMobile String? @map("guardian_mobile")

  // Medical
  allergies String?
  medicalNotes String? @map("medical_notes")

  // Notes
  adminNotes String? @map("admin_notes")

  // Profile extras for rendering
  status StudentStatus @default(Active)
  achievements String?
  paymentStatus PaymentStatus @default(Pending) @map("payment_status")
  attendanceTotal Int @default(0) @map("attendance_total")
  attendancePresent Int @default(0) @map("attendance_present")
  attendanceAbsent Int @default(0) @map("attendance_absent")

  /// Manual fee defaults (INR) — finance module
  monthlyFee      Decimal @default(0) @map("monthly_fee") @db.Decimal(12, 2)
  hostelFee       Decimal @default(0) @map("hostel_fee") @db.Decimal(12, 2)
  otherFee        Decimal @default(0) @map("other_fee") @db.Decimal(12, 2)
  admissionFee    Decimal @default(0) @map("admission_fee") @db.Decimal(12, 2)
  defaultDiscount Decimal @default(0) @map("default_discount") @db.Decimal(12, 2)
  advanceBalance  Decimal @default(0) @map("advance_balance") @db.Decimal(12, 2)

  // QR
  qrCodePath String? @map("qr_code_path") @db.VarChar(400)

  // Biometric mapping (device user id) — uniqueness across student+coach enforced in app
  biometricUserId String? @unique @map("biometric_user_id") @db.VarChar(80)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studentDocuments      StudentDocument?
  loginAccount          User?
  attendanceRecords     Attendance[]
  attendanceSessionsUsed AttendanceSession[] @relation("AttendanceSessionUsedBy")
  feeMonths             StudentFeeMonth[]
  feePayments           StudentFeePayment[]
  playerAchievements    PlayerAchievement[]
  tournamentResults     TournamentResult[]
  parentLinks           ParentStudentLink[]

  @@index([status])
  @@index([coachId])
  @@index([batch])
  @@index([membershipType])
  @@index([joiningDate])
  @@index([biometricUserId])
  @@index([ageCategory])
  @@index([weightCategory])
  @@index([category])
  @@index([mobileNumber])
  @@map("students")
}

model StudentDocument {
  id String @id @default(uuid())
  studentId String @unique @map("student_id")
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  aadhaarFrontImage String? @map("aadhaar_front_image") @db.VarChar(400)
  aadhaarBackImage String? @map("aadhaar_back_image") @db.VarChar(400)
  panCardImage String? @map("pan_card_image") @db.VarChar(400)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("student_documents")
}

model Coach {
  id String @id @default(uuid())

  // Auto-generated
  coachCode String @unique @db.VarChar(50) @map("coach_code")

  photo String? @db.VarChar(400)

  fullName String @db.VarChar(150) @map("full_name")
  fatherName String? @db.VarChar(150) @map("father_name")
  mobile String @db.VarChar(20)
  email String? @db.VarChar(255)
  dateOfBirth DateTime @map("date_of_birth")
  gender String? @db.VarChar(20)

  address String? @db.VarChar(300)

  experienceYears Int? @default(0) @map("experience_years")
  specialization String? // comma-separated or single value
  designation String? @db.VarChar(150)
  qualification String?
  salary Int? @default(0)
  joiningDate DateTime? @map("joining_date")
  /// Job role label (independent from category)
  employeeRole String? @map("employee_role") @db.VarChar(120)
  /// Controlled category: Coach | Assistant Coach | Warden | Cook | Cleaner | Physio
  category String? @map("employee_category") @db.VarChar(40)

  status CoachStatus @default(Active)
  showOnWebsite Boolean @default(false) @map("show_on_website")
  websiteOrder Int @default(0) @map("website_order")

  // Identity numbers (images live in CoachDocument) — optional
  aadhaarNumber String? @unique @db.VarChar(12) @map("aadhaar_number")
  panNumber String? @unique @db.VarChar(10) @map("pan_number")

  // Profile
  achievements String?
  biography String?
  socialLinks Json? @map("social_links")

  // QR
  qrCodePath String? @map("qr_code_path") @db.VarChar(400)

  // Biometric mapping
  biometricUserId String? @unique @map("biometric_user_id") @db.VarChar(80)

  documents CoachDocument?
  students Student[]
  attendanceRecords CoachAttendance[]
  attendanceSessionsUsed CoachAttendanceSession[] @relation("CoachAttendanceSessionUsedBy")
  loginAccount User?
  coachPayments CoachPayment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([biometricUserId])
  @@index([mobile])
  @@map("coaches")
}

model CoachDocument {
  id String @id @default(uuid())
  coachId String @unique @map("coach_id")
  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  aadhaarFrontImage String? @map("aadhaar_front_image") @db.VarChar(400)
  aadhaarBackImage String? @map("aadhaar_back_image") @db.VarChar(400)
  panCardImage String? @map("pan_card_image") @db.VarChar(400)
  certificates Json? @map("certificates")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("coach_documents")
}

// ---------------------------
// QR Attendance Management
// ---------------------------

enum AttendanceSessionStatus {
  ACTIVE
  USED
  EXPIRED
  CLOSED
}

enum AttendanceStatus {
  present
  absent
  leave
  medical_leave
  competition_leave
}

model AttendanceSession {
  id              String                  @id @default(uuid())
  sessionCode     String                  @unique @map("session_code") @db.VarChar(40)
  tokenHash       String                  @unique @map("token_hash") @db.VarChar(128)
  displayToken    String?                 @map("display_token") @db.VarChar(128)
  status          AttendanceSessionStatus @default(ACTIVE)
  source          String                  @default("live") @db.VarChar(20)
  expiresAt       DateTime                @map("expires_at")
  usedAt          DateTime?               @map("used_at")
  usedByStudentId String?                 @map("used_by_student_id")
  usedByStudent   Student?                @relation("AttendanceSessionUsedBy", fields: [usedByStudentId], references: [id], onDelete: SetNull)
  closedAt        DateTime?               @map("closed_at")
  createdById     String?                 @map("created_by_id")
  createdBy       User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  records Attendance[]

  @@index([status])
  @@index([expiresAt])
  @@index([usedByStudentId])
  @@index([source])
  @@map("attendance_sessions")
}

model Attendance {
  id                  String             @id @default(uuid())
  studentId           String             @map("student_id")
  student             Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendanceSessionId String?            @map("attendance_session_id")
  session             AttendanceSession? @relation(fields: [attendanceSessionId], references: [id], onDelete: SetNull)
  registrationId      String             @map("registration_id") @db.VarChar(50)
  date                DateTime           @db.Date
  markedAt            DateTime           @default(now()) @map("marked_at")
  status              AttendanceStatus   @default(present)
  /// Training slot for the calendar date: morning | evening
  sessionSlot         String             @default("morning") @map("session_slot") @db.VarChar(20)
  /// Data plane: live | demo
  source              String             @default("live") @db.VarChar(20)
  /// Marking method shown in UI as Source: QR | MANUAL | BIOMETRIC
  method              String             @default("QR") @db.VarChar(20)
  deviceId            String?            @map("device_id")
  device              BiometricDevice?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  biometricUserId     String?            @map("biometric_user_id") @db.VarChar(80)
  /// GPS geofence fields (QR/mobile attendance)
  latitude            Float?
  longitude           Float?
  gpsAccuracy         Float?             @map("gps_accuracy")
  distanceFromAkhada  Float?             @map("distance_from_akhada")
  locationVerified    Boolean?           @map("location_verified")
  createdAt           DateTime           @default(now()) @map("created_at")

  @@unique([studentId, attendanceSessionId])
  @@unique([studentId, date, sessionSlot])
  @@index([date])
  @@index([registrationId])
  @@index([markedAt])
  @@index([status])
  @@index([studentId, date])
  @@index([sessionSlot])
  @@index([attendanceSessionId])
  @@index([source])
  @@index([method])
  @@index([deviceId])
  @@index([locationVerified])
  @@map("attendance")
}

// ---------------------------
// Coach QR Attendance (separate from student attendance)
// ---------------------------

model CoachAttendanceSession {
  id            String                  @id @default(uuid())
  sessionCode   String                  @unique @map("session_code") @db.VarChar(40)
  tokenHash     String                  @unique @map("token_hash") @db.VarChar(128)
  displayToken  String?                 @map("display_token") @db.VarChar(128)
  status        AttendanceSessionStatus @default(ACTIVE)
  source        String                  @default("live") @db.VarChar(20)
  expiresAt     DateTime                @map("expires_at")
  usedAt        DateTime?               @map("used_at")
  usedByCoachId String?                 @map("used_by_coach_id")
  usedByCoach   Coach?                  @relation("CoachAttendanceSessionUsedBy", fields: [usedByCoachId], references: [id], onDelete: SetNull)
  closedAt      DateTime?               @map("closed_at")
  createdById   String?                 @map("created_by_id")
  createdBy     User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  records CoachAttendance[]

  @@index([status])
  @@index([expiresAt])
  @@index([usedByCoachId])
  @@index([source])
  @@map("coach_attendance_sessions")
}

model CoachAttendance {
  id                  String                  @id @default(uuid())
  coachId             String                  @map("coach_id")
  coach               Coach                   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  attendanceSessionId String?                 @map("attendance_session_id")
  session             CoachAttendanceSession? @relation(fields: [attendanceSessionId], references: [id], onDelete: SetNull)
  coachCode           String                  @map("coach_code") @db.VarChar(50)
  date                DateTime                @db.Date
  markedAt            DateTime                @default(now()) @map("marked_at")
  status              AttendanceStatus        @default(present)
  source              String                  @default("live") @db.VarChar(20)
  method              String                  @default("QR") @db.VarChar(20)
  deviceId            String?                 @map("device_id")
  device              BiometricDevice?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  biometricUserId     String?                 @map("biometric_user_id") @db.VarChar(80)
  latitude            Float?
  longitude           Float?
  gpsAccuracy         Float?                  @map("gps_accuracy")
  distanceFromAkhada  Float?                  @map("distance_from_akhada")
  locationVerified    Boolean?                @map("location_verified")
  createdAt           DateTime                @default(now()) @map("created_at")

  @@unique([coachId, attendanceSessionId])
  @@unique([coachId, date])
  @@index([date])
  @@index([coachCode])
  @@index([markedAt])
  @@index([status])
  @@index([coachId, date])
  @@index([attendanceSessionId])
  @@index([source])
  @@index([method])
  @@index([deviceId])
  @@index([locationVerified])
  @@map("coach_attendance")
}

// ---------------------------
// Biometric devices (adapter-based; no vendor SDK assumed)
// ---------------------------

enum BiometricDeviceStatus {
  online
  offline
  syncing
  error
  disabled
}

model BiometricDevice {
  id           String                @id @default(uuid())
  name         String                @db.VarChar(120)
  deviceType   String                @default("fingerprint") @map("device_type") @db.VarChar(40)
  ipAddress    String?               @map("ip_address") @db.VarChar(80)
  port         Int                   @default(4370)
  location     String?               @db.VarChar(160)
  serialNumber String?               @unique @map("serial_number") @db.VarChar(120)
  /// Shared secret for device → API auth (stored hashed)
  apiSecretHash String               @map("api_secret_hash") @db.VarChar(128)
  /// Adapter key for future device drivers (generic_http, zkteco, etc.)
  adapterKey   String                @default("generic_http") @map("adapter_key") @db.VarChar(40)
  status       BiometricDeviceStatus @default(offline)
  isEnabled    Boolean               @default(true) @map("is_enabled")
  lastSyncAt   DateTime?             @map("last_sync_at")
  lastError    String?               @map("last_error") @db.VarChar(500)
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  logs               BiometricDeviceLog[]
  studentAttendance  Attendance[]
  coachAttendance    CoachAttendance[]

  @@index([status])
  @@index([isEnabled])
  @@map("biometric_devices")
}

model BiometricDeviceLog {
  id              String          @id @default(uuid())
  deviceId        String          @map("device_id")
  device          BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// External log id from device (dedupe)
  deviceLogId     String?         @map("device_log_id") @db.VarChar(120)
  biometricUserId String          @map("biometric_user_id") @db.VarChar(80)
  eventAt         DateTime        @map("event_at")
  rawPayload      Json?           @map("raw_payload")
  /// processed | unknown | duplicate | error
  status          String          @default("processed") @db.VarChar(20)
  message         String?         @db.VarChar(400)
  personType      String?         @map("person_type") @db.VarChar(20)
  personId        String?         @map("person_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@unique([deviceId, deviceLogId])
  @@index([deviceId, eventAt])
  @@index([biometricUserId])
  @@index([status])
  @@map("biometric_device_logs")
}

/// Singleton geofence config for QR attendance (do not hardcode Akhada coords in code).
model AttendanceLocationSetting {
  id                   String   @id @default("default")
  name                 String   @default("Raghunandan wrestling academy") @db.VarChar(160)
  /// Null until admin sets verified coordinates (Use Current Location / Save)
  latitude             Float?
  longitude            Float?
  allowedRadiusMeters  Int      @default(500) @map("allowed_radius_meters")
  maxGpsAccuracyMeters Int      @default(100) @map("max_gps_accuracy_meters")
  isEnabled            Boolean  @default(true) @map("is_enabled")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("attendance_location_settings")
}

/* ─── Manual Fees & Coach Payments (no online gateway) ─── */

enum FeeMonthStatus {
  Paid
  Partial
  Due
  Overdue
}

enum StudentFeeCategory {
  Monthly
  Hostel
  Other
}

enum FinancePaymentMode {
  Cash
  UPI
  BankTransfer
  Other
}

enum CoachPayStatus {
  Paid
  Partial
  Pending
}

/// Fee obligation per student + month + year + category (Monthly / Hostel / Other)
model StudentFeeMonth {
  id           String              @id @default(uuid())
  studentId    String              @map("student_id")
  month        Int
  year         Int
  category     StudentFeeCategory  @default(Monthly)
  title        String?             @db.VarChar(200)
  feeAmount    Decimal             @map("fee_amount") @db.Decimal(12, 2)
  /// Combined bill breakdown (category=Monthly): sum must equal feeAmount
  monthlyAmount Decimal            @default(0) @map("monthly_amount") @db.Decimal(12, 2)
  hostelAmount  Decimal            @default(0) @map("hostel_amount") @db.Decimal(12, 2)
  otherAmount   Decimal            @default(0) @map("other_amount") @db.Decimal(12, 2)
  previousDue  Decimal             @default(0) @map("previous_due") @db.Decimal(12, 2)
  discount     Decimal             @default(0) @db.Decimal(12, 2)
  paidAmount   Decimal             @default(0) @map("paid_amount") @db.Decimal(12, 2)
  remainingDue Decimal             @default(0) @map("remaining_due") @db.Decimal(12, 2)
  status       FeeMonthStatus      @default(Due)
  dueDate      DateTime?           @map("due_date")
  notes        String?             @db.VarChar(500)
  createdById  String?             @map("created_by_id")
  updatedById  String?             @map("updated_by_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  deletedAt    DateTime?           @map("deleted_at")

  student  Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments StudentFeePayment[]

  @@unique([studentId, month, year, category])
  @@index([status])
  @@index([category])
  @@index([year, month])
  @@index([deletedAt])
  @@map("student_fee_months")
}

/// Individual manual fee collection (cash/UPI/bank) with receipt
model StudentFeePayment {
  id                   String             @id @default(uuid())
  feeMonthId           String             @map("fee_month_id")
  studentId            String             @map("student_id")
  amount               Decimal            @db.Decimal(12, 2)
  paymentDate          DateTime           @map("payment_date")
  paymentMode          FinancePaymentMode @map("payment_mode")
  transactionReference String?            @map("transaction_reference") @db.VarChar(120)
  receiptNumber        String             @unique @map("receipt_number") @db.VarChar(40)
  remarks              String?            @db.VarChar(500)
  previousDueSnapshot  Decimal            @default(0) @map("previous_due_snapshot") @db.Decimal(12, 2)
  discountApplied      Decimal            @default(0) @map("discount_applied") @db.Decimal(12, 2)
  feeAmountSnapshot    Decimal            @default(0) @map("fee_amount_snapshot") @db.Decimal(12, 2)
  remainingAfter       Decimal            @default(0) @map("remaining_after") @db.Decimal(12, 2)
  createdById          String?            @map("created_by_id")
  updatedById          String?            @map("updated_by_id")
  deletedAt            DateTime?          @map("deleted_at")
  deletedById          String?            @map("deleted_by_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  feeMonth StudentFeeMonth @relation(fields: [feeMonthId], references: [id], onDelete: Cascade)
  student  Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([paymentDate])
  @@index([paymentMode])
  @@index([deletedAt])
  @@map("student_fee_payments")
}

/// Monthly coach salary payment record (manual)
model CoachPayment {
  id                   String             @id @default(uuid())
  coachId              String             @map("coach_id")
  month                Int
  year                 Int
  baseSalary           Decimal            @map("base_salary") @db.Decimal(12, 2)
  bonus                Decimal            @default(0) @db.Decimal(12, 2)
  deduction            Decimal            @default(0) @db.Decimal(12, 2)
  netPayable           Decimal            @map("net_payable") @db.Decimal(12, 2)
  paidAmount           Decimal            @map("paid_amount") @db.Decimal(12, 2)
  remainingAmount      Decimal            @map("remaining_amount") @db.Decimal(12, 2)
  paymentDate          DateTime           @map("payment_date")
  paymentMode          FinancePaymentMode @map("payment_mode")
  transactionReference String?            @map("transaction_reference") @db.VarChar(120)
  voucherNumber        String             @unique @map("voucher_number") @db.VarChar(40)
  status               CoachPayStatus     @default(Pending)
  remarks              String?            @db.VarChar(500)
  createdById          String?            @map("created_by_id")
  updatedById          String?            @map("updated_by_id")
  deletedAt            DateTime?          @map("deleted_at")
  deletedById          String?            @map("deleted_by_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([coachId, month, year])
  @@index([status])
  @@index([year, month])
  @@index([paymentDate])
  @@index([deletedAt])
  @@map("coach_payments")
}

model FinanceSequence {
  id        String @id @default(uuid())
  key       String @db.VarChar(40)
  year      Int
  lastValue Int    @default(0) @map("last_value")

  @@unique([key, year])
  @@map("finance_sequences")
}

/// Durable copy of uploaded files (Render disk is ephemeral; Postgres survives redeploy).
model MediaBlob {
  relativePath String   @id @map("relative_path") @db.VarChar(500)
  mimeType     String   @map("mime_type") @db.VarChar(120)
  byteSize     Int      @map("byte_size")
  data         Bytes
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("media_blobs")
}

/** Parent portal account — linked to one or more players (students) */
model ParentProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  fullName  String   @map("full_name") @db.VarChar(150)
  phone     String?  @db.VarChar(20)
  email     String?  @db.VarChar(255)
  relation  String?  @db.VarChar(80)
  photo     String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  links ParentStudentLink[]

  @@index([phone])
  @@map("parent_profiles")
}

model ParentStudentLink {
  id        String   @id @default(uuid())
  parentId  String   @map("parent_id")
  studentId String   @map("student_id")
  relation  String?  @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  parent  ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
  @@map("parent_student_links")
}

/** Per-player competition achievements (separate from CMS homepage Achievement stats) */
model PlayerAchievement {
  id              String    @id @default(uuid())
  /// Optional link to registered student (legacy); prefer playerName for public display
  studentId       String?   @map("student_id")
  /// Free-text player name shown on public website
  playerName      String?   @map("player_name") @db.VarChar(150)
  title           String    @db.VarChar(200)
  description     String?   @db.VarChar(2000)
  /// Competition/event level used for medal tallying
  level           String?   @db.VarChar(40)
  achievementType String?   @map("achievement_type") @db.VarChar(80)
  tournamentId    String?   @map("tournament_id")
  tournamentName  String?   @map("tournament_name") @db.VarChar(200)
  achievedOn      DateTime? @map("achieved_on")
  year            Int?
  medal           String?   @db.VarChar(40)
  result          String?   @db.VarChar(120)
  image           String?   @db.VarChar(500)
  /// When true, achievement appears on the public Champions Wall
  showOnWebsite   Boolean   @default(true) @map("show_on_website")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  student    Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([playerName])
  @@index([tournamentId])
  @@index([medal])
  @@index([level])
  @@index([year])
  @@index([achievedOn])
  @@index([showOnWebsite])
  @@map("player_achievements")
}

model Tournament {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(200)
  eventDate DateTime @map("event_date")
  location  String?  @db.VarChar(200)
  category  String?  @db.VarChar(120)
  remarks   String?  @db.VarChar(2000)
  image     String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  results            TournamentResult[]
  playerAchievements PlayerAchievement[]

  @@index([eventDate])
  @@map("tournaments")
}

model TournamentResult {
  id           String  @id @default(uuid())
  tournamentId String  @map("tournament_id")
  studentId    String  @map("student_id")
  category     String? @db.VarChar(120)
  result       String? @db.VarChar(120)
  position     String? @db.VarChar(40)
  medal        String? @db.VarChar(40)
  remarks      String? @db.VarChar(2000)
  image        String? @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, studentId])
  @@index([studentId])
  @@map("tournament_results")
}

enum SponsorshipStatus {
  Active
  Expired
  Upcoming
  Cancelled
}

/// Admin-only sponsorship / partnership records (not public)
model Sponsorship {
  id               String             @id @default(uuid())
  sponsorName      String             @map("sponsor_name") @db.VarChar(200)
  sponsorshipType  String             @map("sponsorship_type") @db.VarChar(120)
  /// Sponsorship value in INR (was Decimal(12,2) — overflowed for large totals)
  amount           Decimal            @default(0) @db.Decimal(18, 2)
  startDate        DateTime           @map("start_date")
  endDate          DateTime?          @map("end_date")
  status           SponsorshipStatus  @default(Active)
  documentPath     String?            @map("document_path") @db.VarChar(500)
  documentName     String?            @map("document_name") @db.VarChar(255)
  notes            String?            @db.VarChar(2000)
  createdById      String?            @map("created_by_id")
  updatedById      String?            @map("updated_by_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  deletedAt        DateTime?          @map("deleted_at")

  @@index([sponsorName])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([deletedAt])
  @@map("sponsorships")
}

